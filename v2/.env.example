# Copy to .env and fill in. NEVER commit the real .env file.
#
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs of bot admins, e.g. "123456789,987654321" (required for admin commands)
ADMIN_CHAT_IDS=

# Fernet key used to encrypt Facebook Page tokens at rest (required)
CONFIG_ENCRYPTION_KEY=

# SQLite database file (a directory will be created if needed)
DATABASE_FILE=data/bot.db

# Meta Graph API version, e.g. v26.0
GRAPH_API_VERSION=v26.0

# Seconds between Facebook poll cycles (minimum 60)
POLL_INTERVAL_SECONDS=300

# First-sync behaviour for a newly approved page: "skip" records existing posts
# silently, "send" forwards up to 25 recent posts to subscribers
INITIAL_SYNC=skip

# Default language for new users: "en" or "vi"
DEFAULT_LANGUAGE=en

# Max Telegram messages sent concurrently during fan-out
FANOUT_CONCURRENCY=10
